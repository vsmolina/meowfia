# ─────────────────────────────────────────────────────────────────────────────
#  Meowfia environment variables
#  Copy to .env (`cp .env.example .env`) and fill in what you have.
#  EVERYTHING is optional locally. Missing keys switch that integration to a mock:
#    Stripe  → local mock checkout page      Resend   → emails printed to console
#    S3/R2   → files on local disk (./storage) Printful → mock catalog + logged orders
#    Google  → sign-in button hidden          Upstash  → in-memory rate limiting
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
# Local SQLite file. Production: a Postgres URL from Neon/Supabase (see README → "Switching to Postgres").
DATABASE_URL="file:./dev.db"

# Public URL of the site (used in emails, Stripe redirects, OG images, sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3847"

# ── Auth.js ───────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Production: your site URL. Locally the default is fine.
AUTH_URL="http://localhost:3847"
# Comma-separated emails that automatically become admins on sign-in.
ADMIN_EMAILS="admin@example.com"
# Google sign-in: https://console.cloud.google.com/apis/credentials → OAuth client ID (Web)
#   Authorized redirect URI: {SITE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Stripe ────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys  (use sk_test_… until launch)
STRIPE_SECRET_KEY=""
# Local: run `stripe listen --forward-to localhost:3847/api/stripe/webhook` and paste the whsec_… it prints.
# Production: Dashboard → Developers → Webhooks → add endpoint {SITE_URL}/api/stripe/webhook
#   Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#           customer.subscription.created, customer.subscription.updated, customer.subscription.deleted,
#           invoice.paid, charge.refunded
STRIPE_WEBHOOK_SECRET=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
# https://resend.com/api-keys. Verify your sending domain at https://resend.com/domains
RESEND_API_KEY=""
# Must be on a verified domain in production, e.g. "Meowfia <hq@yourdomain.com>"
EMAIL_FROM=""
EMAIL_REPLY_TO=""

# ── File storage ──────────────────────────────────────────────────────────────
# "local" (default) writes to ./storage. Use "s3" on Vercel, since its filesystem is read-only/ephemeral.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="storage"
# S3 or Cloudflare R2 (R2: https://dash.cloudflare.com → R2 → Manage API tokens)
#   R2 endpoint looks like https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region "auto"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for PUBLIC images (R2 public bucket / custom domain / CloudFront).
# Private files (PDFs) are always streamed through the app, never exposed.
NEXT_PUBLIC_MEDIA_BASE_URL=""

# ── Printful (print-on-demand merch) ──────────────────────────────────────────
# https://www.printful.com/dashboard/developer → create a private token (scopes: orders, products/sync)
PRINTFUL_API_KEY=""
# Only needed if the token has access to multiple stores
PRINTFUL_STORE_ID=""

# ── Security ──────────────────────────────────────────────────────────────────
# Signs expiring download links. Falls back to AUTH_SECRET. Generate: openssl rand -base64 32
DOWNLOAD_SIGNING_SECRET=""
# Mock checkout (completes orders WITHOUT payment) runs only when STRIPE_SECRET_KEY is empty,
# and is disabled in production unless this is "true" (use only for a private staging demo).
ALLOW_MOCK_PAYMENTS=""
# Protects /api/cron/* (Vercel Cron sends it automatically as a Bearer token). Generate: openssl rand -hex 16
CRON_SECRET=""
# Optional distributed rate limiting (recommended on Vercel): https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Analytics & pixels (all optional) ─────────────────────────────────────────
# "1" to enable Vercel Web Analytics (enable it in the Vercel dashboard too)
NEXT_PUBLIC_VERCEL_ANALYTICS=""
# e.g. "yourdomain.com" if using Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# TikTok Ads Manager → Assets → Events → Web Events → Pixel ID
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
# Meta Events Manager → Data Sources → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=""
